      "baggage": null,
      "platformCall": false,
      "options": {
        "defaultTenant": null,
        "requireTenant": false,
        "validateAgainstStore": true
      },
      "storeUnavailable": false,
      "expected": {
        "tenant": "acme",
        "displayName": "Acme"
      }
    },
    {
      "name": "没有声明时取 Baggage 的 xihan.tenant",
