{
  "$comment": "清单的读取（RFC-0002 解析规则 2，ADR-0233、ADR-0235）：valid 的每份必须读得出，invalid 的每份必须被拒绝（.NET 为 KERNEL_CAPABILITY_006）。manifest 是清单的 JSON 值；text 是原文，用于 JSON 值表达不了的写法（重复成员）。reason 只给人看，说明这份为什么不合法",
  "valid": [
    {
      "name": "最小的能力清单",
      "manifest": {
        "id": "xihan.orders.core",
        "version": "1.0.0",
        "primitives": "1",
        "stability": "stable",
        "kind": "capability"
      }
    },
    {
      "name": "带全部可选成员的 Provider",
      "manifest": {
        "$schema": "https://spec.xihanfun.com/manifest/v1.json",
        "id": "xihan.orders.core",
        "package": "XiHan.Orders.Core",
        "version": "1.2.3-rc.1+build.5",
        "primitives": "1",
        "stability": "preview",
        "kind": "provider",
        "role": "default",
        "provides": [
          {
            "id": "orders.store",
            "version": "2"
          }
        ],
        "requires": [
          {
            "id": "kernel.hosting",
            "version": "^1"
          },
          {
            "id": "caching.local",
            "version": "1",
            "optional": true
          }
        ],
        "bindings": [
          {
            "name": "orders-db",
            "type": "connection:relational",
            "required": false
          }
        ],
        "contributes": {
          "operations": [
            "orders.create",
            "order-lines.list"
          ],
          "config": {
            "section": "XiHan:Orders:Core",
            "schema": "{\"type\":\"object\",\"properties\":{\"limit\":{\"type\":\"integer\"}}}"
          },
          "health": [
            "orders.core.store"
          ],
          "permissions": [
            "orders.order.create"
          ]
        },
        "activation": [
          "onStartup"
        ],
        "entry": "XiHan.Orders.Core.OrdersFeature"
      }
    },
    {
      "name": "进程外插件",
      "manifest": {
        "id": "xihan.samples.echo",
        "version": "0.1.0",
        "primitives": "1",
        "stability": "experimental",
        "kind": "plugin",
        "isolation": "out-of-process",
        "contributes": {
          "operations": [
            "echoes.create"
          ]
        },
        "activation": [
          "onOperation:echoes.*",
          "onEvent:echo.events"
        ],
        "permissions": [
          "capability:kernel.pipeline",
          "net.outbound:example.com:443"
        ],
        "entry": "echo-go"
      }
    }
  ],
