      "name": "值的类型不符",
      "request": "counts",
      "payload": "{\"a\":\"x\"}",
      "reason": "$.a"
    },
    {
      "name": "第二个成员不符",
      "request": "counts",
      "payload": "{\"a\":1,\"b\":\"x\"}",
      "reason": "$.b"
    },
    {
      "name": "小数不是整数",
      "request": "counts",
      "payload": "{\"a\":1.5}",
      "reason": "$.a"
    },
    {
      "name": "null 不是整数",
