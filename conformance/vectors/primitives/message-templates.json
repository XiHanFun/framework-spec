      "kernel.op x",
      "kernel.opé",
      "a.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "orders.line.invalid\n"
    ]
  },
  "format": [
    {
      "name": "按名字",
      "template": "Operation '{id}' is not registered.",
      "arguments": {
        "id": "orders.create"
      },
      "lenient": "Operation 'orders.create' is not registered.",
      "strict": "Operation 'orders.create' is not registered."
    },
    {
      "name": "按位置",
      "template": "{0} of {1}",
      "arguments": {
        "0": "a",
        "1": "b"
      },
      "lenient": "a of b",
      "strict": "a of b"
    },
    {
      "name": "名字带下划线",
      "template": "{user_id}",
      "arguments": {
        "user_id": "u1"
      },
      "lenient": "u1",
      "strict": "u1"
    },
    {
      "name": "同一占位符两次",
      "template": "{a}{a}",
      "arguments": {
        "a": "z"
      },
      "lenient": "zz",
      "strict": "zz"
    },
    {
      "name": "缺值",
      "template": "Hello {name}",
      "arguments": {},
      "lenient": "Hello {name}",
      "strict": null
    },
    {
      "name": "缺值连同格式说明符保留",
      "template": "{amount:N2} paid",
      "arguments": {},
