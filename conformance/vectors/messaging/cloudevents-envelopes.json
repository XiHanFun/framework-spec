      "expected": {
        "id": "0190b3c4-7d1e-7c3a-9f5b-2a1c3d4e5f60",
        "source": "/orders",
        "type": "orders.placed",
        "time": "2026-01-02T03:04:05Z",
        "subject": "order/42",
        "datacontenttype": "application/json",
        "data": {
          "total": 42,
          "lines": [
            "a",
            "b"
          ]
        },
        "extensions": {
