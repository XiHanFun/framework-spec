{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.xihanfun.com/manifest/v1.json",
  "title": "XiHan manifest",
  "description": "xihan.manifest.json：能力包、Provider、插件、宿主与协议适配器的自描述清单。",
  "type": "object",
  "required": ["id", "version", "primitives", "stability", "kind"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^xihan\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9-]*$",
      "description": "清单 ID：xihan.<领域>.<名称>"
    },
    "package": { "type": "string", "description": "所属包 ID（.NET 为 NuGet 包 ID）" },
    "version": { "$ref": "#/$defs/semver" },
    "primitives": { "$ref": "#/$defs/interfaceVersion", "description": "所依赖的原语层大版本" },
    "stability": { "enum": ["stable", "preview", "experimental", "internal", "deprecated"] },
    "kind": { "enum": ["capability", "provider", "plugin", "host", "protocol"] },
    "role": { "enum": ["provider", "default"], "default": "provider", "description": "default：没有显式 Provider 时被选中的实现" },
    "isolation": { "enum": ["in-process", "wasm", "out-of-process"], "description": "仅 kind=plugin" },
    "provides": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "description": "能力 ID 重复不在 Schema 里拒绝，由跨字段约束报 duplicate_provides（RFC-0002 解析规则 2 第 4 步）" },
    "requires": { "type": "array", "items": { "$ref": "#/$defs/requirement" }, "description": "能力 ID 重复不在 Schema 里拒绝，由跨字段约束报 duplicate_requires（RFC-0002 解析规则 2 第 4 步）" },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "contributes": { "$ref": "#/$defs/contributions" },
    "activation": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(onStartup|onOperation:[a-z0-9.*-]+|onEvent:[a-z0-9._*-]+)$" },
      "default": ["onStartup"],
      "description": "激活事件（plugin/lifecycle.md §3）：onOperation: 的模式用操作 ID 的字符加 *，onEvent: 的模式用主题的字符（含下划线，RFC-0009）加 *"
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(net\\.outbound|fs\\.read|fs\\.write|capability):.+$" },
      "description": "插件所需权限，宿主配置授予"
    },
    "entry": { "type": "string", "description": "入口类型的完全限定名（.NET）或等价标识" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "capabilityId": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9-]*$" },
    "interfaceVersion": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$",
      "description": "接口版本：不带前导零的十进制正整数，不超过 2147483647（RFC-0001「清单」）"
    },
    "capability": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "$ref": "#/$defs/interfaceVersion" }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": {
          "type": "string",
          "pattern": "^(\\^)?([1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$",
          "description": "接口版本（同 interfaceVersion），可带一个 ^"
        },
        "optional": { "type": "boolean", "default": false }
      }
    },
    "binding": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "type": { "type": "string", "pattern": "^[a-z]+(:[a-z]+)?$", "description": "connection:relational、cache:distributed、queue、blob、stream、configuration:remote（与 spec/packaging/app-manifest.md 的绑定类型一致）" },
        "required": { "type": "boolean", "default": true }
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pipeline": {
          "type": "array",
          "description": "管道中间件（RFC-0004）；插件里只有 isolation 为 wasm 的能贡献，进程外与进程内插件写了非空的 pipeline 由宿主在发现或加载时拒绝（PLUGINS_VALIDATION_001，plugin/lifecycle.md §1）",
          "items": {
            "type": "object",
            "required": ["middleware", "stage"],
            "additionalProperties": false,
            "properties": {
              "middleware": { "type": "string", "minLength": 1 },
              "stage": { "enum": ["ingress", "observe", "resilience", "authenticate", "tenant", "authorize", "validate", "idempotency", "transaction", "handle", "egress"] },
              "before": { "type": "array", "items": { "type": "string" } },
              "after": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "operations": { "type": "array", "items": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$" }, "description": "操作 ID（conventions/operation-ids.md）：<resource>.<verb>，不超过 128 个字符" },
        "config": {
          "type": "object",
          "required": ["section"],
          "additionalProperties": false,
          "properties": {
            "section": { "type": "string", "pattern": "^XiHan:[A-Z][A-Za-z0-9]*(:[A-Z][A-Za-z0-9]*)*$", "description": "领域节 XiHan:<领域>，可再带一层或多层 PascalCase 子节（RFC-0002「配置节」）" },
            "schema": { "type": "string" }
          }
        },
        "permissions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" }, "uniqueItems": true, "description": "此包定义的权限码（RFC-0008 权限码文法）；插件的由宿主在登记它的代理操作时一并登记（plugin/invocation.md §1）" },
        "health": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" } }
      }
    }
  }
}
